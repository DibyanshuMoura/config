{
  "position": "bottom",
  "spacing": 0,
  "height": 30,
  "reload_style_on_change": true,
  "layer": "top",
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "bluetooth",
    "network",
    "pulseaudio",
    "battery"
  ],
  "hyprland/window": {
    "max-length": 20
  },
  "bluetooth": {
    "format": "bth",
    "format-connected": "bth",
    "format-disabled": "bth off",
    "format-no-controller": "bth none",
    "tooltip": false,
    "on-click": "foot -e bluetui"
  },
  "cpu": {
    "format": "cpu {usage}%",
    "interval": 2,
    "states": {
      "critical": 90
    },
    "tooltip": false
  },
 "memory": {
    "format": "mem {percentage}%",
    "interval": 2,
    "states": {
        "critical": 80
    },
    "on-click": "foot -e btop",
    "tooltip": false
 },
 "battery": {
    "format": "bat {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip": false
  },
  "network": {
    "format-wifi": "wifi {bandwidthDownBits}",
    "format-ethernet": "eth {bandwidthDownBits}",
    "format-disconnected": "no network",
    "interval": 5,
    "tooltip": false,
    "on-click":"foot -e impala"
  },
  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "vol {volume}%",
    "format-bluetooth": "vol {volume}%",
    "nospacing": 1,
    "on-click": "foot -e wiremix",
    "tooltip": false
  },
  "clock": {
    "format": "{:%d %b %a %H:%M}",
    "tooltip": false,
    "interval": 1
  }
} 
